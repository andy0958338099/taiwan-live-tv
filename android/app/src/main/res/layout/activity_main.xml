<?xml version="1.0" encoding="utf-8"?>
<!--
  主版面：1920x1080 橫向配置
  ┌────────────────────────────────────────────────────────┐
  │  [標題列]  頻道 / 最愛 / 最近     [搜尋]                │
  ├────────────────────────────────────────────────────────┤
  │                                                        │
  │              播放器（全螢幕，可被頻道列覆蓋）           │
  │                                                        │
  │                                                        │
  ├────────────────────────────────────────────────────────┤
  │  [頻道資訊列：台標 名稱 狀態]                          │
  ├────────────────────────────────────────────────────────┤
  │  [分類列：全部 新聞 綜合 娛樂 財經 ...]                │
  │  [頻道卡片列（可橫向滾動）]                            │
  └────────────────────────────────────────────────────────┘
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background"
    android:keepScreenOn="true">

    <!-- ===== 頂部標題列 ===== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/safe_margin_horizontal"
        android:paddingEnd="@dimen/safe_margin_horizontal"
        android:paddingTop="@dimen/safe_margin_vertical_compact"
        android:paddingBottom="@dimen/safe_margin_vertical_compact"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_tv_live"
            android:textColor="@color/tv_text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginEnd="32dp" />

        <!-- 分頁：頻道 / 最愛 / 最近 -->
        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tabChannels"
                style="@style/ChannelTab"
                android:text="@string/tab_channels" />

            <TextView
                android:id="@+id/tabFavorites"
                style="@style/ChannelTab"
                android:text="@string/tab_favorites" />

            <TextView
                android:id="@+id/tabRecent"
                style="@style/ChannelTab"
                android:text="@string/tab_recent" />
        </LinearLayout>

        <!-- 搜尋按鈕 -->
        <TextView
            android:id="@+id/btnSearch"
            style="@style/ChannelTab"
            android:text="@string/action_search"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- ===== 播放器容器 ===== -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/channelInfoBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:use_controller="false"
            app:surface_type="surface_view"
            app:show_buffering="when_playing"
            android:background="@color/tv_background" />

        <!--
          官方嵌入播放器（授權狀態 A 的來源）。
          與 PlayerView 互斥顯示：embed 頻道用 WebView，其餘用 ExoPlayer。
        -->
        <WebView
            android:id="@+id/embedWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/tv_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone" />

        <!-- 載入指示 -->
        <ProgressBar
            android:id="@+id/loadingIndicator"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/tv_status_buffering"
            android:visibility="gone" />

        <!-- 錯誤面板 -->
        <LinearLayout
            android:id="@+id/errorPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/tv_scrim"
            android:visibility="gone"
            android:padding="@dimen/safe_margin_horizontal">

            <TextView
                android:id="@+id/errorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/state_error"
                android:textColor="@color/tv_status_error"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/errorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/tv_text_primary"
                android:textSize="@dimen/text_status"
                android:gravity="center"
                tools:text="無法連線到串流伺服器，請檢查網路連線" />

            <TextView
                android:id="@+id/btnRetry"
                style="@style/ChannelTab"
                android:layout_marginTop="28dp"
                android:text="@string/action_retry"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- ===== 頻道資訊列 ===== -->
    <LinearLayout
        android:id="@+id/channelInfoBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/safe_margin_horizontal"
        android:paddingEnd="@dimen/safe_margin_horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/categoryBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/channelLogo"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:layout_marginEnd="14dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/tab_channels" />

        <TextView
            android:id="@+id/currentChannelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_no_channel"
            android:textColor="@color/tv_text_primary"
            android:textSize="@dimen/text_status"
            android:textStyle="bold"
            android:maxWidth="520dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/playStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:textColor="@color/tv_text_secondary"
            android:textSize="@dimen/text_channel_meta"
            android:maxLines="1" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnChannelInfo"
            style="@style/ChannelTab"
            android:text="@string/action_settings" />

    </LinearLayout>

    <!-- ===== 分類列 ===== -->
    <HorizontalScrollView
        android:id="@+id/categoryBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="@dimen/safe_margin_horizontal"
        android:paddingEnd="@dimen/safe_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@id/channelListBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/categoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- ===== 頻道列 ===== -->
    <FrameLayout
        android:id="@+id/channelListBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/channel_card_height"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="@dimen/safe_margin_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/safe_margin_horizontal_compact"
            android:paddingEnd="@dimen/safe_margin_horizontal_compact"
            android:scrollbars="none"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/tv_text_muted"
            android:textSize="@dimen/text_status"
            android:visibility="gone"
            tools:text="尚未收藏任何頻道" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
