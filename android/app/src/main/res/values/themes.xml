<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      電視主題：全螢幕、無 ActionBar、深色背景（省電且不干擾直播畫面）
    -->
    <style name="Theme.TaiwanLiveTV" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackground">@color/tv_background</item>
        <item name="android:textColorPrimary">@color/tv_text_primary</item>
        <item name="android:textColorSecondary">@color/tv_text_secondary</item>
    </style>

    <!-- 頻道列卡片 -->
    <style name="ChannelCard">
        <item name="android:layout_width">@dimen/channel_card_width</item>
        <item name="android:layout_height">@dimen/channel_card_height</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_margin">@dimen/channel_card_spacing</item>
        <item name="android:background">@drawable/bg_channel_card</item>
    </style>

</resources>
